[Unit]
Description=Fantasy dashboard — fast data refresh (prices, ownership, news, lineups)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/fantasy-dashboard/ingest
ExecStart=/usr/bin/env bash ./update.sh --fast
# don't let a hung scrape pile up runs
TimeoutStartSec=900
Nice=10
