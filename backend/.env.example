# The `fantasy` CLI reads its environment from the process, then $FANTASY_ENV_FILE,
# then ./.env (this file, copied). The home runner's lives at
# ~/.config/fantasy-dashboard/env (written by infra/home/install.sh).

DATABASE_URL=postgresql://localhost/fantasy
# WEB_CRYPTO_KEY=...                     # decrypts the league cookies stored from the app

# UEFA season/competition id (bump when a new season starts; default 90)
# UEFA_COMP_ID=90
# UEFA_FEEDS_BASE=https://gaming.uefa.com/en/uclfantasy/services/feeds
# UEFA_API_BASE=https://gaming.uefa.com/en/uclfantasy/services/api
# UEFA_ENTITY=ed0t4n$3!

# External xG source (soccerdata league names; season like "2526", blank = current)
# SOURCE_LEAGUES=ENG-Premier League,ESP-La Liga,GER-Bundesliga,ITA-Serie A,FRA-Ligue 1
# FBREF_SEASON=
# SKIP_SOURCES=1

# --- recent form (Sofascore, all competitions) ---
# RECENT_FORM_SOURCE=sofascore     # or "understat" (domestic only, needs soccerdata)
# RECENT_FORM_LOOKBACK=5           # last N matches
# RECENT_FORM_MIN_PRICE=4.5        # skip form scrape for players cheaper than this
